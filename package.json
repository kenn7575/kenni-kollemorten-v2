{
	"name": "kenni-kollemorten-v2",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"host": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo \"\"",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"daisyui": "^5.7.50",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"svelte-intersection-observer": "^2.2.0",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.8.1",
		"typescript": "^6.0.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"type": "module",
	"dependencies": {
		"@sentry/sveltekit": "^11.9.0",
		"@vercel/analytics": "^2.0.1",
		"firebase": "^13.1.0",
		"firebase-admin": "^14.5.0",
		"sharp": "^0.35.5"
	},
	"engines": {
		"node": ">=22.17"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"overrides": {
		"@vercel/analytics": {
			"@sveltejs/kit": "$@sveltejs/kit"
		},
		"@grpc/grpc-js": "^1.14.6",
		"jwks-rsa": {
			"jose": "^5.10.0"
		}
	}
}
